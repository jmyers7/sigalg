## ***************************************************************************
## * LINES                                                                   *
## ***************************************************************************

lines.linewidth: 2
lines.markersize: 4

## ***************************************************************************
## * PATCHES                                                                 *
## ***************************************************************************

patch.linewidth: 0.2
patch.edgecolor: E9E4F7

## ***************************************************************************
## * FONT                                                                    *
## ***************************************************************************

font.family:  monospace
font.monospace:  DejaVu Sans Mono, Bitstream Vera Sans Mono, Computer Modern Typewriter, Andale Mono, Nimbus Mono L, Courier New, Courier, Fixed, Terminal, monospace

## ***************************************************************************
## * TEXT                                                                    *
## ***************************************************************************

text.color: E9E4F7

## ***************************************************************************
## * AXES                                                                    *
## ***************************************************************************

axes.facecolor: 05030A
axes.labelcolor: E9E4F7

axes.prop_cycle: cycler('color', ['B026FF', 'FF2E97', '00E5FF', '3DFFA8', 'FFB347', '9D6BFF', 'FF7AB8', '8A7FB0'])

axes.edgecolor: E9E4F7
axes.linewidth: 0.6
axes.spines.right:  False
axes.spines.top:  False

axes.titlesize : 11
axes.labelsize : 10

axes.labelpad: 6

## ***************************************************************************
## * TICKS                                                                   *
## ***************************************************************************

xtick.color: E9E4F7
ytick.color: E9E4F7

xtick.labelsize : 10
ytick.labelsize : 10

## ***************************************************************************
## * GRIDS                                                                   *
## ***************************************************************************

axes.grid: True
grid.color: 8A7FB0
grid.linestyle: --
grid.linewidth: 0.6
grid.alpha:     0.3


## ***************************************************************************
## * LEGEND                                                                  *
## ***************************************************************************

legend.labelcolor: E9E4F7
legend.facecolor: 0A0612
legend.edgecolor: 5B14B0
legend.fontsize: 12

## ***************************************************************************
## * FIGURE                                                                  *
## ***************************************************************************

figure.dpi: 100
savefig.dpi : 200
figure.facecolor: 05030A
savefig.facecolor: 05030A
pdf.fonttype: 42
