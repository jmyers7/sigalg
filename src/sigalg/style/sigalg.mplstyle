## ***************************************************************************
## * LINES                                                                   *
## ***************************************************************************

lines.linewidth: 2
lines.markersize: 4

## ***************************************************************************
## * PATCHES                                                                 *
## ***************************************************************************

patch.linewidth: 0.2
patch.edgecolor: black

## ***************************************************************************
## * FONT                                                                    *
## ***************************************************************************

font.family:  monospace
font.monospace:  DejaVu Sans Mono, Bitstream Vera Sans Mono, Computer Modern Typewriter, Andale Mono, Nimbus Mono L, Courier New, Courier, Fixed, Terminal, monospace

## ***************************************************************************
## * TEXT                                                                    *
## ***************************************************************************

text.color: black

## ***************************************************************************
## * AXES                                                                    *
## ***************************************************************************

axes.facecolor: white
axes.labelcolor: black

axes.prop_cycle: cycler('color', ['6743DC'])

axes.edgecolor: black
axes.linewidth: 0.6
axes.spines.right:  False
axes.spines.top:  False

axes.titlesize : 10
axes.labelsize : 9

axes.labelpad: 6

## ***************************************************************************
## * TICKS                                                                   *
## ***************************************************************************

xtick.color: black
ytick.color: black

xtick.labelsize : 8
ytick.labelsize : 8

## ***************************************************************************
## * GRIDS                                                                   *
## ***************************************************************************

axes.grid: True
grid.color: black
grid.linestyle: --
grid.linewidth: 0.6
grid.alpha:     0.4


## ***************************************************************************
## * LEGEND                                                                  *
## ***************************************************************************

legend.labelcolor: black
legend.facecolor: white
legend.edgecolor: black
legend.fontsize: 8

## ***************************************************************************
## * FIGURE                                                                  *
## ***************************************************************************

figure.dpi: 100
savefig.dpi : 200
figure.facecolor: white
pdf.fonttype: 42